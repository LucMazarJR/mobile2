# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > Data API > Project URL e anon public key).
#
# O prefixo EXPO_PUBLIC_ é obrigatório: é o que faz o Expo injetar a variável
# no bundle do app. Nunca coloque aqui a service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
