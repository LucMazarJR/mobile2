{
  "expo": {
    "name": "Stamp",
    "slug": "luciano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stamp",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "package": "com.controlemanutencao.app",
      "adaptiveIcon": {
        "backgroundColor": "#161616",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161616",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#161616",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "./plugins/withOcrModel",
      "expo-sqlite",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "O Stamp usa a câmera para ler as etiquetas QR e as plaquetas dos equipamentos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7052959e-e959-4a9c-915e-5de16e3b4662"
      }
    },
    "owner": "lucianomazars-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/36cf00d9-2337-465c-afa5-8d150a4b0887"
    }
  }
}
